# Production example. Never commit a real .env or credentials.
APP_ENV=production
DEBUG=False
# Set a generated random secret of at least 50 characters.
SECRET_KEY=
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
APP_DATA_DIR=.runtime-data
# Windows service: use an absolute path if the venv is outside the repository.
# PYTHON_EXECUTABLE=C:/plit99/venv/Scripts/python.exe
# Prefer PostgreSQL with a trusted CA and a dedicated runtime role.
# DATABASE_URL=postgresql://APP_USER:URL_ENCODED_PASSWORD@DB_HOST/APP_DB?sslmode=verify-full
# For migrations, the operator may set MIGRATION_DATABASE_URL in the build process
# environment. Keep that schema owner's credentials OUT of this service .env.
SERVE_MEDIA_FILES=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
TRUST_PROXY_HEADERS=False
WAITRESS_HOST=127.0.0.1
WAITRESS_PORT=8000
WAITRESS_THREADS=4
# Behind a local IIS proxy that replaces forwarded headers:
# WAITRESS_TRUSTED_PROXY=127.0.0.1
# Set credentials only when explicitly running create_admin_if_missing, then remove them.
# Startup never creates admin accounts automatically.
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=
